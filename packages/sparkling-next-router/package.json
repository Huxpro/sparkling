{
  "name": "sparkling-next-router",
  "version": "0.1.0",
  "description": "Next.js App Router file conventions and next/navigation API on ReactLynx, driving sparkling-navigation (native MPA)",
  "homepage": "https://tiktok.github.io/sparkling/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiktok/sparkling",
    "directory": "packages/sparkling-next-router"
  },
  "main": "dist/build/index.js",
  "types": "dist/build/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./navigation": {
      "types": "./src/runtime/navigation.ts",
      "default": "./src/runtime/navigation.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "build": "tsc -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "sparkling-history-shim": "workspace:*"
  },
  "peerDependencies": {
    "@lynx-js/react": "*",
    "sparkling-navigation": "*"
  },
  "devDependencies": {
    "@lynx-js/react": "^0.116.2",
    "@lynx-js/types": "3.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.8.3"
  }
}
