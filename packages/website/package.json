{
  "name": "sparkling-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-examples": "node scripts/prepare-examples.mjs",
    "build:methods": "pnpm --filter sparkling-method build && pnpm --filter sparkling-navigation --filter sparkling-storage --filter sparkling-media build",
    "dev": "pnpm build:methods && pnpm prepare-examples && rspress dev",
    "build": "pnpm build:methods && pnpm prepare-examples && rspress build",
    "preview": "rspress preview",
    "gen:api": "typedoc && typedoc --options typedoc.app-config.json"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.74.0",
    "@douyinfe/semi-ui": "^2.75.0",
    "@lynx-js/go-web": "^0.5.1",
    "@lynx-js/lynx-core": "0.1.3",
    "@lynx-js/web-core": "^0.20.3",
    "@lynx-js/web-elements": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react-copy-to-clipboard": "^5.1.0",
    "sparkling-media": "workspace:*",
    "sparkling-method": "workspace:*",
    "sparkling-navigation": "workspace:*",
    "sparkling-storage": "workspace:*",
    "swr": "^2.2.5",
    "vscode-icons-js": "^11.6.1"
  },
  "devDependencies": {
    "@rsbuild/plugin-sass": "^1.5.1",
    "@rspack/core": "2.0.0-alpha.1",
    "@rspress/core": "^2.0.3",
    "@rspress/plugin-llms": "^2.0.3",
    "@shikijs/transformers": "^3.4.2",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "playwright": "^1.58.2",
    "sparkling-types": "workspace:*",
    "typedoc": "^0.26.11",
    "typedoc-plugin-markdown": "~4.2.10"
  },
  "engines": {
    "node": ">=20"
  }
}
