{
  "name": "sparkling-navigation",
  "platforms": ["android", "ios", "web"],
  "version": "1.0.0",
  "description": "Router methods for navigation and page management in Sparkling apps",
  "methods": {
    "open": {
      "description": "Navigate to a new page or route",
      "parameters": {
        "scheme": "string",
        "params": "Record<string, any>",
        "options": "Record<string, any>"
      },
      "returns": {
        "success": "boolean",
        "message": "string",
        "data": "any"
      }
    },
    "close": {
      "description": "Close the current page or route",
      "parameters": {
        "containerID": "string",
        "animated": "boolean"
      },
      "returns": {
        "success": "boolean"
      }
    },
    "stack": {
      "description": "Execute a URL-first native container stack command",
      "parameters": {
        "command": "string",
        "path": "string",
        "search": "Record<string, string>",
        "bundle": "string",
        "scheme": "string",
        "presentation": "push | modal",
        "entryId": "string",
        "entries": "Array<object>",
        "result": "any",
        "animated": "boolean",
        "usePrefetched": "boolean"
      },
      "returns": {
        "entryId": "string",
        "state": "StackState"
      }
    }
  },
  "android": {
    "packageName": "com.tiktok.sparkling.method.router",
    "className": "RouterMethod",
    "buildGradle": "android/build.gradle.kts"
  },
  "ios": {
    "moduleName": "Router",
    "className": "RouterMethod",
    "podspecPath": "ios/Sparkling-Router.podspec",
    "swiftVersion": "5.0"
  },
  "web": {
    "entryPoint": "index.ts",
    "bundleName": "router.bundle"
  }
}
