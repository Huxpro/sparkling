  "description": "File-route compiler for Sparkling Router with TanStack and Next.js authoring frontends",
  "homepage": "https://tiktok.github.io/sparkling/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiktok/sparkling",
    "directory": "packages/sparkling-router-plugin"
  },
  "type": "module",
