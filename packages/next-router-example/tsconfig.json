{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@lynx-js/rspeedy/client"]
  },
  "include": ["app", "lynx.config.ts", ".sparkling"],
  "exclude": ["dist", "node_modules"]
}
